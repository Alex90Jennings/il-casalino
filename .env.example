# =============================================================================
# Il Casino Casalino — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# =============================================================================

# --- Database (server-only) --------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- PayPal (server-only secret, public client id) ---------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CURRENCY=EUR

# --- Business Info (browser-safe) --------------------------------------------
NEXT_PUBLIC_BUSINESS_EMAIL=ilcasinocasalino@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=+393277755170
NEXT_PUBLIC_BUSINESS_ADDRESS=via Casalino, 18, 72021, Francavilla Fontana, Brindisi, Italy

# --- Booking Rules (browser-safe) --------------------------------------------
NEXT_PUBLIC_BOOKING_MIN_NIGHTS=3
NEXT_PUBLIC_BREAKFAST_PRICE_PER_PERSON_PER_NIGHT=6
NEXT_PUBLIC_MAX_GUESTS_PER_ROOM=2

# --- Site Config (browser-safe) ----------------------------------------------
NEXT_PUBLIC_SITE_NAME=Il Casino Casalino
NEXT_PUBLIC_DEFAULT_LOCALE=it
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# --- iCal Integration (server-only) ------------------------------------------
# Paste the .ics export URLs from Airbnb / Booking.com here
ICAL_MIRTILLO_IMPORT_URL=
ICAL_LIMONE_IMPORT_URL=
ICAL_ORIA_IMPORT_URL=
ICAL_FRANCAVILLA_IMPORT_URL=
# Secret token to protect the /api/ical/export endpoints
ICAL_EXPORT_SECRET=
